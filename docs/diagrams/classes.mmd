%% Core classes and database entities (from sql/scolaria.sql)
classDiagram
    direction LR

    class Database {
        <<static>> getConnection(): PDO
        - connection: PDO
    }

    class NotificationSystem {
        + createNotification(userId, title, message, type, data)
        + createNotificationForRole(title, message, type, role, data)
        + createAdminNotification(title, message, type, data)
        + notifyStockOut(productId, name, qty)
        + notifyLowStock(productId, name, qty, threshold)
        + notifyNewSale(saleId, total, clientName)
        + notifyStockMovement(productId, name, action, qty, user)
        + notifyExpense(expenseId, amount, description)
        + notifySystemIssue(issue, details)
        + checkStockAlerts()
        + cleanupOldNotifications(days)
    }

    class AlertsManager {
        + getLowStockItems()
        + updateThreshold(articleId, newThreshold)
        + createOrder(articleId, fournisseurId, quantite, prixUnitaire, notes)
        + listOrders(limit)
        + updateOrderStatus(orderId, newStatus)
        + getSuppliers()
        + addSupplier(...)
        + updateSupplier(...)
        + deleteSupplier(id)
        + getAllArticles()
        + getAlertStats()
    }

    class BaseController {
        # render(view, data)
    }

    class HomeController {
        + index()
    }

    %% Database entities (key fields only)
    class users {
        id: int PK
        username: varchar
        full_name: varchar
        email: varchar
        role: enum
        status: enum
    }
    class stocks {
        id: int PK
        nom_article: varchar
        categorie: varchar
        prix_achat: decimal
        prix_vente: decimal
        quantite: int
        seuil_alerte: int
    }
    class sales {
        id: int PK
        client_id: int FK
        total: decimal
        created_at: timestamp
    }
    class sales_items {
        id: int PK
        sale_id: int FK
        product_id: int FK
        quantity: int
        price: decimal
    }
    class transactions {
        id: int PK
        sale_id: int FK
        amount: decimal
        payment_method: enum
        paid_at: timestamp
    }
    class clients {
        id: int PK
        first_name: varchar
        last_name: varchar
        phone: varchar
        email: varchar
    }
    class depenses {
        id: int PK
        description: varchar
        montant: decimal
        date: date
        categorie_id: int FK
    }
    class categories {
        id: int PK
        nom: varchar
        type: enum
        couleur: varchar
    }
    class fournisseurs {
        id: int PK
        nom: varchar
        contact: varchar
        email: varchar
        telephone: varchar
    }
    class commandes {
        id: int PK
        article_id: int FK
        fournisseur_id: int FK
        quantite: int
        prix_unitaire: decimal
        statut: enum
        date_commande: timestamp
    }
    class alertes {
        id: int PK
        stock_id: int FK
        type: enum
        message: varchar
        created_at: timestamp
    }
    class mouvements {
        id: int PK
        article_id: int FK
        action: varchar
        details: text
        date_mouvement: timestamp
    }
    class budgets {
        id: int PK
        mois: int
        annee: int
        montant_prevu: decimal
        categorie_id: int FK
    }
    class notifications {
        id: int PK
        user_id: int FK
        title: varchar
        type: enum
        is_read: tinyint
        created_at: timestamp
    }

    %% Relationships
    sales --> clients : client_id
    sales_items --> sales : sale_id
    sales_items --> stocks : product_id
    transactions --> sales : sale_id
    alertes --> stocks : stock_id
    mouvements --> stocks : article_id
    commandes --> stocks : article_id
    commandes --> fournisseurs : fournisseur_id
    depenses --> categories : categorie_id
    notifications --> users : user_id

    %% Code uses
    Database <.. NotificationSystem : uses
    Database <.. AlertsManager : uses
    BaseController <|-- HomeController

